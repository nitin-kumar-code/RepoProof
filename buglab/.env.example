# Local BugLab API. Public deployments are configured as Render service variables.
APP_ENV=development
PORT=4317
BUGLAB_HOST=127.0.0.1
BUGLAB_PORT=4317
BUGLAB_PUBLIC_DEPLOYMENT=false
BUGLAB_UI_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
BUGLAB_RESET_TOKEN=replace-with-a-random-secret-at-least-32-characters
# Match the ReproProof APPROVAL_USERNAME and APPROVAL_PASSWORD for automated TC3 runs.
BUGLAB_APPROVAL_USERNAME=reviewer
BUGLAB_APPROVAL_PASSWORD=replace-with-a-long-random-secret
VITE_BUGLAB_API_BASE_URL=
