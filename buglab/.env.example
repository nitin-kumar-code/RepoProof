# BugLab server binds to loopback and never listens publicly by default.
BUGLAB_HOST=127.0.0.1
BUGLAB_PORT=4317

# Vite proxies /api requests to the local BugLab API.
VITE_BUGLAB_API_PROXY=http://127.0.0.1:4317

# Optional test-only reset bearer secret. Leave empty for loopback-only demos.
BUGLAB_RESET_TOKEN=
