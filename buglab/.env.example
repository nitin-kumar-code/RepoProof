# Local BugLab API and browser UI integration settings. Copy to .env and replace
# the reset token with a random value of at least 32 characters.
BUGLAB_PORT=4317
BUGLAB_HOST=127.0.0.1
BUGLAB_WEB_HOST=0.0.0.0
BUGLAB_RESET_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
BUGLAB_UI_ORIGINS=http://host.docker.internal:4173,http://localhost:4173,http://127.0.0.1:4173
VITE_BUGLAB_API_PROXY=http://127.0.0.1:4317
