{
  "name": "reproproof-buglab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "start:api": "node dist/server/index.js",
    "test:api": "tsx --test tests/api.test.ts",
    "test:e2e": "npm run build && tsx --test tests/e2e.test.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
