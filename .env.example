# Leave empty for same-origin Docker/Nginx API proxying. Vite development uses localhost:4000 by default.
# Set a deployment-specific API origin only when the API is hosted separately.
VITE_API_BASE_URL=

# Docker Compose development settings. Use real secret values only in an untracked .env file.
APP_ENV=development
CORS_ORIGIN=http://localhost:8080
ALLOW_INSECURE_LOCAL_TARGETS=false
ALLOWED_TARGET_ORIGINS=
# For the controlled BugLab demo, set these together (development only):
# APP_ENV=development
# ALLOW_INSECURE_LOCAL_TARGETS=true
# BUGLAB_BASE_URL=http://host.docker.internal:4173
# ALLOWED_TARGET_ORIGINS=http://host.docker.internal:4173
# ALLOWED_RESOURCE_ORIGINS=http://host.docker.internal:4173
# VERIFICATION_RESET_URL=http://host.docker.internal:4173/api/sandbox/reset
# BUGLAB_RESET_TOKEN=<same random value configured in buglab/.env>
# Docker Compose uses these defaults for BugLab when its origin is allowlisted:
# BUGLAB_BASE_URL=http://host.docker.internal:4173
# ALLOWED_TARGET_ORIGINS=http://host.docker.internal:4173
# VERIFICATION_RESET_URL=http://host.docker.internal:4173/api/sandbox/reset
# VERIFICATION_RESET_TOKEN=<same random value configured in buglab/.env>
ALLOWED_RESOURCE_ORIGINS=
PLANNER_MODE=mock
OPENAI_MODEL=gpt-4o-mini
APPROVAL_USERNAME=reviewer
APPROVAL_PASSWORD=replace-with-a-long-random-secret
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# OPENAI_API_KEY=
