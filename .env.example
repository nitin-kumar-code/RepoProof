# Leave empty for same-origin Docker/Nginx API proxying. Vite development uses localhost:4000 by default.
# Set a deployment-specific API origin only when the API is hosted separately.
VITE_API_BASE_URL=

# Docker Compose development settings. Use real secret values only in an untracked .env file.
APP_ENV=development
CORS_ORIGIN=http://localhost:8080
ALLOW_INSECURE_LOCAL_TARGETS=false
ALLOWED_TARGET_ORIGINS=
ALLOWED_RESOURCE_ORIGINS=
PLANNER_MODE=mock
OPENAI_MODEL=gpt-4o-mini
APPROVAL_USERNAME=reviewer
APPROVAL_PASSWORD=replace-with-a-long-random-secret
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# OPENAI_API_KEY=
