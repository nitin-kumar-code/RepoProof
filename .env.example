# Leave empty for same-origin Docker/Nginx API proxying. Vite development uses localhost:4000 by default.
# Set a deployment-specific API origin only when the API is hosted separately.
VITE_API_BASE_URL=

# Docker Compose development settings. Use real secret values only in an untracked .env file.
APP_ENV=development
CORS_ORIGIN=http://localhost:8080
BUGLAB_BASE_URL=http://host.docker.internal:4173
ALLOWED_TARGET_ORIGINS=http://host.docker.internal:4173
ALLOWED_RESOURCE_ORIGINS=http://host.docker.internal:4173
VERIFICATION_RESET_URL=http://host.docker.internal:4173/api/sandbox/reset
RUN_ARTIFACTS_DIR=./reproproof-api/artifacts
EVIDENCE_STORAGE_BUCKET=reproproof-evidence
PLANNER_MODE=mock
OPENAI_MODEL=gpt-4o-mini
# Approval credentials, Supabase keys, reset token, and model API key belong in
# reproproof-api/.env (loaded by Compose), not this file.
# OPENAI_API_KEY=
