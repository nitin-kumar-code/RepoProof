PORT=4000
# Comma-separated exact hostnames; subdomains are not included automatically.
ALLOWED_TARGET_HOSTS=localhost,127.0.0.1,approved-demo.example
# Common HTTP development ports. Add other approved HTTP service ports explicitly.
ALLOWED_TARGET_PORTS=80,443,3000,4000,4173,5000,5173,8000,8080,8081,8443
# Mock planner is deterministic and requires no model credentials.
PLANNER_MODE=mock
OPENAI_MODEL=gpt-4o-mini
# Configure both values to enable persistent Supabase storage.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# For real model planning, set PLANNER_MODE=openai and provide this API key.
# OPENAI_API_KEY=your-openai-api-key
# Approval endpoint is disabled until server-side credentials are configured.
# Use HTTPS in deployed environments; the username is recorded as the approver.
APPROVAL_USERNAME=reviewer
APPROVAL_PASSWORD=replace-with-a-long-random-secret
