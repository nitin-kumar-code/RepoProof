PORT=4000
APP_ENV=development
CORS_ORIGIN=http://localhost:5173
# Keep false unless testing an explicitly allowlisted localhost/private app locally.
ALLOW_INSECURE_LOCAL_TARGETS=false
RUN_ARTIFACTS_DIR=artifacts/runs
EVIDENCE_STORAGE_BUCKET=reproproof-evidence
# Optional; required to enable two-attempt verification. Must reset only authorized disposable fixtures.
# VERIFICATION_RESET_URL=https://approved-demo.example/test-support/reset
# VERIFICATION_RESET_TOKEN=server-side-reset-token
# Only set this to the verified, authorized HTTPS demo origin. Do not add paths or wildcards.
ALLOWED_TARGET_ORIGINS=
# Explicit HTTPS origins required for the approved app's API and static assets.
ALLOWED_RESOURCE_ORIGINS=
# Local-only example (requires APP_ENV=development and ALLOW_INSECURE_LOCAL_TARGETS=true):
# ALLOWED_TARGET_ORIGINS=http://localhost:3000
# ALLOWED_RESOURCE_ORIGINS=http://localhost:4000
# Mock planner is deterministic and requires no model credentials.
PLANNER_MODE=mock
OPENAI_MODEL=gpt-4o-mini
# Required for durable runs, the shared worker queue, and persistent storage.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# EVIDENCE_STORAGE_BUCKET=reproproof-evidence (create as a private bucket)
# For real model planning, set PLANNER_MODE=openai and provide this API key.
# OPENAI_API_KEY=your-openai-api-key
# Approval endpoint is disabled until server-side credentials are configured.
# Use HTTPS in deployed environments; the username is recorded as the approver.
APPROVAL_USERNAME=reviewer
APPROVAL_PASSWORD=replace-with-a-long-random-secret
