PORT=4000
# Comma-separated exact hostnames; subdomains are not included automatically.
ALLOWED_TARGET_HOSTS=localhost,127.0.0.1,approved-demo.example
# Common HTTP development ports. Add other approved HTTP service ports explicitly.
ALLOWED_TARGET_PORTS=80,443,3000,4000,4173,5000,5173,8000,8080,8081,8443
# Configure both values to enable persistent Supabase storage.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
